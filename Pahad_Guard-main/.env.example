NASA_API_KEY=optional-key
APP_ENV=development

# Shared secret ID that every Admin account must re-enter at login (in
# addition to email + password). Change this for real deployments.
ADMIN_SECRET_ID=PAHAD-ADMIN-2024

# Brevo (Sendinblue) transactional email.
# Get an API key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your-brevo-api-key

# Required: the "from" address for all auth emails. This MUST be a verified
# sender in your Brevo account (Settings -> Senders, Domains & Dedicated IPs).
BREVO_SENDER_EMAIL=you@example.com
BREVO_SENDER_NAME=Pahad Guard

# Automatic: every user who signs up or logs in gets an email themselves
# (welcome email on signup, login alert on login) — no extra config needed
# beyond BREVO_API_KEY and BREVO_SENDER_EMAIL above.

# Optional: if set, you (the site owner) ALSO get an email alert every time
# anyone signs up or logs in. Leave as the default / blank to skip this.
NOTIFY_EMAIL=you@example.com